{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["index.ts", "rpc.ts", "tui.tsx", "test/**/*.ts"],
  "exclude": ["test/shim"]
}
